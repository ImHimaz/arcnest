{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"testsEnvironment": false,
	"port": 8892,
	"plugins": [
		"../elite-blocks",
		"https://downloads.wordpress.org/plugin/contact-form-7.zip",
		"https://downloads.wordpress.org/plugin/wordpress-seo.zip"
	],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"SCRIPT_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": "local",
		"WP_DEVELOPMENT_MODE": "theme"
	},
	"mappings": {
		"wp-content/themes/arcnest": "."
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp theme activate arcnest"
	}
}
