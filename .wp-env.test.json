{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"testsEnvironment": false,
	"port": 8893,
	"plugins": [
		"../elite-blocks"
	],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_DISPLAY": true,
		"WP_DEBUG_LOG": false,
		"SCRIPT_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": "local",
		"WP_DEVELOPMENT_MODE": "theme"
	},
	"mappings": {
		"wp-content/themes/arcnest": "."
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli --config=.wp-env.test.json wp theme activate arcnest"
	}
}
