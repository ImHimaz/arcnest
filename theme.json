{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "XS",
					"size": "0.25rem"
				},
				{
					"slug": "20",
					"name": "S",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "clamp(1.5rem, 3vw, 2rem)"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "clamp(2rem, 5vw, 3rem)"
				},
				{
					"slug": "60",
					"name": "2XL",
					"size": "clamp(3rem, 8vw, 5rem)"
				},
				{
					"slug": "70",
					"name": "3XL",
					"size": "clamp(4rem, 10vw, 7.5rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"Plus Jakarta Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/PlusJakartaSans-Latin-VariableFont_wght.woff2"
							]
						}
					]
				},
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "var(--wp--preset--font-family--body)"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "sm",
					"name": "Small",
					"shadow": "0 1px 2px rgb(0 0 0 / 0.06), 0 1px 3px rgb(0 0 0 / 0.1)"
				},
				{
					"slug": "md",
					"name": "Medium",
					"shadow": "0 4px 12px rgb(0 0 0 / 0.08)"
				},
				{
					"slug": "lg",
					"name": "Large",
					"shadow": "0 12px 32px rgb(0 0 0 / 0.12)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|text"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"left": "clamp(20px, 5.5vw, 80px)",
				"right": "clamp(20px, 5.5vw, 80px)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|primary-900"
				},
				"border": {
					"radius": "999px"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent",
						"text": "var:preset|color|primary-900"
					}
				},
				"spacing": {
					"padding": {
						"top": "18px",
						"bottom": "18px",
						"left": "28px",
						"right": "28px"
					}
				},
				"typography": {
					"fontFamily": "var(--text-button-font-family)",
					"fontSize": "var(--text-button-font-size)",
					"fontWeight": "var(--text-button-font-weight)",
					"lineHeight": "1.25",
					"letterSpacing": "var(--text-button-letter-spacing)",
					"textTransform": "var(--text-button-text-transform)"
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
